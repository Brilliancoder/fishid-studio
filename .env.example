# =============================================================================
# FishID Studio — Exemplo de configuração (.env.example)
# Copie este arquivo para `.env` e preencha apenas o que desejar utilizar.
# =============================================================================

# --- Modelo Keras (Backend) ---
MODEL_PATH=models/modelo.keras
NORMALIZE_DIV_255=true
PRESERVE_ASPECT_RATIO=true

# --- Pipeline de Coleta de Fotos (local | s3 | gcs) ---
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_PREFIX=fishid_collected
LOCAL_STORAGE_DIR=collected_data

# Credenciais AWS S3 / Cloudflare R2 / MinIO (apenas se STORAGE_BACKEND=s3)
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# Credenciais Google Cloud Storage (apenas se STORAGE_BACKEND=gcs)
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Frontend (Streamlit) ---
BACKEND_URL=http://backend:8080
GDRIVE_FOLDER_URL=
GITHUB_URL=https://github.com/viniciusscience
CONTACT_EMAIL=jose.8797080@edu.univali.br
CONTACT_URL=mailto:jose.8797080@edu.univali.br
COAUTHOR_NAME=Prof. Dr. Rodrigo Sant'Ana
PIX_KEY=
PIX_PAYLOAD=
SUPPORT_URL=
